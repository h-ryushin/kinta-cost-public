# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# アカウントを移すときに書き出すお店のデータ（scripts/move-data.mjs）
/move-data/

# wrangler dev（Cloudflare の手元のサーバー）の一時ファイル
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# まとめた SQL（npm run db:sql で作り直す）
/supabase/all.sql
/supabase/seed.sql

# アプリから取り出したデータ（端末の中身。Git に入れない）
/kinta.json*

# Supabase CLI の作業ファイル
/supabase/.temp/

# バックアップの合言葉など（パスワード管理アプリに移したら消す）
/backup-secrets.txt
